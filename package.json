{
  "name": "crowed-rank",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx ./packages/db/src/migrate.ts",
    "db:debug": "tsx ./debug-env.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:hydration": "playwright test -c playwright.hydration.config.ts",
    "test:loading": "playwright test -c playwright.loading.config.ts",
    "preview:loading": "node tests/loading/build.cjs && node tests/loading/serve.cjs",
    "test:events": "playwright test -c playwright.events.config.ts",
    "preview:events": "vite --config tests/events/vite.config.mts --host 127.0.0.1 --port 14313 --strictPort"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.5",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.3",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "prettier": "^3.5.3",
    "tsx": "^4.20.5",
    "turbo": "^2.5.8",
    "typescript": "5.8.2",
    "vite": "6.4.1",
    "vitest": "3.2.6"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "drizzle-orm": "^0.44.5"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-spring/web": "^10.0.1",
    "@stackframe/react": "^2.8.41",
    "@supabase/ssr": "^0.7.0",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.525.0",
    "next": "16.0.8",
    "radix-ui": "^1.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.60.0",
    "zod": "^3.25.64"
  }
}
